# Python
PYTHONUNBUFFERED=1

# --- Football data providers (v8: دو منبع اصلی) ---
# football-data.org — توکن رایگان از https://www.football-data.org (بازی‌های پیش‌رو + جدول)
FOOTBALL_DATA_ORG_TOKEN=
# football-data.co.uk — بدون کلید (CSV هفتگی با xG؛ کاری لازم نیست)
# API-Football — فقط fallback پولی؛ خالی بماند تا مستقیماً مصرف نکند
API_FOOTBALL_KEY=
API_FOOTBALL_BASE=https://v3.football.api-sports.io

# --- LLM (interface قابل تعویض؛ هیچ کلیدی در مخزن) ---
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=          # از @BotFather
TELEGRAM_CHANNEL_ID=         # مثال: -1001234567890
TELEGRAM_GROUP_ID=
ADMIN_TELEGRAM_IDS=          # شناسه‌های عددی مجاز، جدا با کاما — فقط این‌ها می‌توانند approve/reject کنند

# --- Storage (اختیاری؛ پیش‌فرض data/ در همان پوشه) ---
DATABASE_PATH=data/dev.sqlite
RAW_PAYLOAD_DIR=data/raw      # CSV/JSON خام provider با sha256

# --- Timezone ---
DISPLAY_TZ=Asia/Tehran       # ذخیره همیشه UTC؛ نمایش «به وقت تهران (UTC+3:30)»
