# Python
PYTHONUNBUFFERED=1

# --- Football data providers (v8: دو منبع اصلی) ---
FOOTBALL_DATA_ORG_TOKEN=
ODDS_API_KEY=                # رایگان ۵۰۰ درخواست/ماه بدون کارت: https://the-odds-api.com (ضرایب زنده +EV)
API_FOOTBALL_KEY=
API_FOOTBALL_BASE=https://v3.football.api-sports.io

# --- LLM Text Generation — زنجیرهٔ پشتیبان چندارائه‌دهنده (v0.17.1) ---
# 1) اولویت اول: Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL_CHAIN=gemini-4-hydrogen,gemini-4-neon,gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-2.5-flash

LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
LLM_MAX_ATTEMPTS=2
LLM_BACKOFF_SECONDS=3

# 2) کلید همه‌کاره Pollinations (متن + تصویر FLUX + ویدیو Seedance از https://enter.pollinations.ai/keys):
POLLINATIONS_API_KEY=

# 3) پشتیبان‌های رایگان فارسی‌دان (بدون کارت بانکی — هر کدام را پر کنی خودکار وارد زنجیره می‌شود):
GITHUB_MODELS_TOKEN=         # رایگان با اکانت GitHub (Personal Access Token): 150 req/day (Llama 3.3, Command A, DeepSeek)
AXFORGE_API_KEY=             # رایگان اروپا: https://axforge.ai (3M tokens/30 days — qwen3.8-27b و glm-5.3-flash)
CEREBRAS_API_KEY=            # رایگان: https://cloud.cerebras.ai (1M tokens/day — qwen-3-32b و llama-3.3-70b)
SAMBANOVA_API_KEY=           # رایگان: https://cloud.sambanova.ai (Llama 3.3 70B و Qwen 2.5 72B)
OPENROUTER_API_KEY=          # رایگان: https://openrouter.ai/keys (gemma-4-31b-it:free)
COHERE_API_KEY=              # رایگان: https://dashboard.cohere.com/api-keys (Command A و Aya Expanse 32B فارسی عالی)
MISTRAL_API_KEY=             # رایگان: https://console.mistral.ai/api-keys
NVIDIA_API_KEY=              # رایگان: https://build.nvidia.com (1000 اعتبار/ماه برای متن + تصویر FLUX.1)
CLOUDFLARE_ACCOUNT_ID=       # رایگان: https://dash.cloudflare.com (10,000 Neurons/day برای متن + تصویر FLUX.1)
CLOUDFLARE_API_TOKEN=
ZAI_API_KEY=                 # رایگان دائمی: https://z.ai (GLM-4.7-Flash)
GROQ_API_KEY=                # اختیاری (در صورت دسترسی با VPN)

# پشتیبان اضطراری بدون کلید (OVHcloud Qwen3.5-397B + Kilo Code + LLM7.io رایگان بدون کلید)
LLM_ENABLE_ANONYMOUS_FALLBACK=1

# --- Free High-Quality Image & Video Generation (v0.17.1) ---
# (POLLINATIONS_API_KEY + CLOUDFLARE + NVIDIA_API_KEY بالا برای تصویر/ویدیو هم خودکار استفاده می‌شوند)
REPLICATE_API_TOKEN=         # $5 اعتبار رایگان بدون کارت: https://replicate.com (FLUX + ویدیو Wan 2.1)
STABILITY_API_KEY=           # 25 اعتبار رایگان ماهانه: https://platform.stability.ai
HF_TOKEN=                    # رایگان: https://huggingface.co/settings/tokens (FLUX + Wan 2.1 + LTX-Video)

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_GROUP_ID=
ADMIN_TELEGRAM_IDS=

# --- Storage & Timezone ---
DATABASE_PATH=data/dev.sqlite
RAW_PAYLOAD_DIR=data/raw
DISPLAY_TZ=Asia/Tehran
