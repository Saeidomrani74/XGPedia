# Python
PYTHONUNBUFFERED=1

# --- Football data providers (only one key active at a time) ---
API_FOOTBALL_KEY=            # https://www.api-football.com  (Free: 100 req/day)
API_FOOTBALL_BASE=https://v3.football.api-sports.io
FOOTBALL_DATA_ORG_TOKEN=     # https://www.football-data.org (Free: 12 competitions, 10 req/min)
SPORTMONKS_TOKEN=            # https://www.sportmonks.com/football-api (فقط پس از Gate 2)

# --- LLM (interface قابل تعویض؛ هیچ کلیدی در مخزن) ---
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=          # از @BotFather
TELEGRAM_CHANNEL_ID=         # مثال: -1001234567890
TELEGRAM_GROUP_ID=
ADMIN_TELEGRAM_IDS=          # شناسه‌های عددی مجاز، جدا با کاما — فقط این‌ها می‌توانند approve/reject کنند

# --- Storage ---
DATABASE_PATH=data/dev.sqlite
RAW_PAYLOAD_DIR=data/raw      # پاسخ خام provider در حد مجوز

# --- Timezone ---
DISPLAY_TZ=Asia/Tehran       # ذخیره همیشه UTC؛ نمایش «به وقت تهران (UTC+3:30)»
