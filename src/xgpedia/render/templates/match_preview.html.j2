{# قالب کارت پیش‌بازی — استودیو XGPedia (tools/matchday_studio.html) — عیناً همان طراحی #}
{# منبع طراحی: فایل استودیو؛ همهٔ رنگ‌ها از brand.json (matchday_palette) و رنگ تیم‌ها از
   config/team_identities.json تزریق می‌شود — هیچ هگز برندی در قالب هاردکد نیست.
   ماژول‌ها عین رجیستری استودیو هستند: stats/radar/focus/watchout/keyduel/poisson/wave/trend10/signals؛
   ماژولی که داده‌اش در fact_json نیست رندر نمی‌شود (بلوکش برای دادهٔ آینده محفوظ است). #}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="utf-8">
<title>XGPedia | {{ home.name_fa }} × {{ away.name_fa }}</title>
<style>
  {% for f in fonts %}
  @font-face { font-family: '{{ f.family }}'; src: url('{{ f.data }}') format('woff2'); font-weight: {{ f.weight }}; }
  {% endfor %}

  :root {
    --bg-studio: {{ palette.bg_studio }};
    --bg-card: {{ palette.bg_card }};
    --bg-panel: {{ palette.bg_panel }};
    --bg-deep: {{ palette.bg_deep }};
    --bg-deep-90: {{ palette.bg_deep_90 }};
    --card-grad-from: {{ palette.card_grad_from }};
    --card-grad-to: {{ palette.card_grad_to }};
    --glass-grad-from: {{ palette.glass_grad_from }};
    --glass-grad-to: {{ palette.glass_grad_to }};
    --accent-red: {{ palette.accent_red }};
    --ink-deep: {{ palette.ink_deep }};
    --duel-vs-red: {{ palette.duel_vs_red }};
    --emerald: {{ palette.emerald }};
    --emerald-bright: {{ palette.emerald_bright }};
    --amber: {{ palette.amber }};
    --amber-bright: {{ palette.amber_bright }};
    --amber-soft: {{ palette.amber_soft }};
    --sky-bright: {{ palette.sky_bright }};
    --sky-bright-light: {{ palette.sky_bright_light }};
    --draw-grey: {{ palette.draw_grey }};
    --text-bright: {{ palette.text_bright }};
    --text-body: {{ palette.text_body }};
    --text-soft: {{ palette.text_soft }};
    --text-line: {{ palette.text_line }};
    --text-slate: {{ palette.text_slate }};
    --text-muted: {{ palette.text_muted }};
    --home-color: {{ home.color }};
    --away-color: {{ away.color }};
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body { width: {{ format.w }}px; height: {{ format.h }}px; }
  body {
    font-family: 'Vazirmatn', system-ui, -apple-system, sans-serif;
    background: var(--bg-card);
    color: var(--text-bright);
    direction: rtl; unicode-bidi: plaintext;
    font-feature-settings: "tnum" 1;
    font-variant-numeric: tabular-nums;
    user-select: none;
    overflow: hidden;
  }
  .font-mono-en { font-family: 'JetBrains Mono', 'Space Grotesk', monospace; font-feature-settings: "tnum" 1; }
  .font-display-en { font-family: 'Space Grotesk', sans-serif; font-feature-settings: "tnum" 1; }

  /* ── بوم قفل‌شده ── */
  #export-artboard {
    position: relative;
    width: {{ format.w }}px; height: {{ format.h }}px;
    background: var(--bg-card);
    display: flex; flex-direction: column; justify-content: space-between;
    overflow: hidden;
  }
  #card-ambient-glow { position: absolute; inset: 0; z-index: 0; pointer-events: none; background: {{ pitch.ambient }}; }
  #card-pitch-svg { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; }
  .broadcast-scanlines {
    position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background: repeating-linear-gradient(to bottom,
      rgba(255, 255, 255, 0.015) 0px, rgba(255, 255, 255, 0.015) 1px,
      transparent 1px, transparent 4px);
  }

  /* ── معماری کارت شیشه‌ای و کارت تحریریه تیره — عین استودیو ── */
  .xg-glass-card {
    position: relative;
    background: linear-gradient(165deg, var(--glass-grad-from) 0%, var(--glass-grad-to) 100%);
    border: 1px solid rgba(248, 250, 252, 0.12);
    border-radius: 20px;
    padding: 14px 18px;
    box-shadow: 0 12px 32px -8px rgba(0, 0, 0, 0.5), inset 0 1px 0 0 rgba(255, 255, 255, 0.08);
    display: flex; flex-direction: column; justify-content: space-between;
    overflow: hidden;
  }
  .xg-tactical-editorial {
    position: relative;
    background: linear-gradient(150deg, var(--card-grad-from) 0%, var(--card-grad-to) 100%);
    border: 1px solid rgba(127, 166, 232, 0.22);
    border-radius: 20px;
    padding: 14px 18px;
    box-shadow: 0 12px 32px -8px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.1);
    display: flex; flex-direction: column; justify-content: space-between;
    overflow: hidden;
  }
  .xg-tactical-editorial::before {
    content: ''; position: absolute; left: -18%; bottom: -55%;
    width: 85%; height: 130%;
    border: 1px solid rgba(127, 166, 232, 0.14);
    border-radius: 50%; transform: rotate(-22deg);
    pointer-events: none;
  }

  /* ── کپسول واحد احتمال ۱X۲ ── */
  .prob-capsule {
    width: 100%; height: 36px; border-radius: 999px; overflow: hidden;
    display: flex;
    background: rgba(15, 23, 42, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.5);
  }
  .prob-seg {
    height: 100%; display: flex; align-items: center; justify-content: center;
    font-weight: 900; font-size: 16px; border-radius: 0 !important;
  }

  /* ── میله‌های مقایسهٔ متناسب تخت ── */
  .comp-bar-track { height: 11px; background: rgba(255, 255, 255, 0.08); overflow: hidden; display: flex; align-items: center; }
  .comp-bar-track.home-side { border-radius: 0 999px 999px 0; justify-content: flex-end; }
  .comp-bar-track.away-side { border-radius: 999px 0 0 999px; justify-content: flex-start; }
  .comp-bar-fill-home { height: 100%; border-radius: 0 999px 999px 0; }
  .comp-bar-fill-away { height: 100%; border-radius: 999px 0 0 999px; }

  /* ── دایره‌های فرم ── */
  .form-dot {
    width: 28px; height: 28px; border-radius: 999px;
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 13px; font-weight: 900;
    border: 1px solid rgba(255, 255, 255, 0.18);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.35);
  }
  .form-W { background: var(--emerald); color: var(--ink-deep); }
  .form-D { background: var(--amber); color: var(--ink-deep); }
  .form-L { background: var(--accent-red); color: #FFFFFF; }

  /* ── سرصفحهٔ کارت ── */
  #card-masthead {
    position: relative; z-index: 10;
    padding: 28px 36px 12px;
    display: flex; align-items: flex-start; justify-content: space-between; gap: 16px;
    flex-shrink: 0;
  }
  .masthead-left { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; }
  .masthead-pills { display: flex; align-items: center; gap: 10px; }
  .pill-competition {
    padding: 6px 16px; border-radius: 999px;
    font-size: 18px; font-weight: 900;
    display: flex; align-items: center; gap: 8px;
    color: var(--text-bright);
    background-color: rgba(21, 35, 71, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.13);
  }
  .pill-round {
    padding: 6px 16px; border-radius: 999px;
    font-size: 17px; font-weight: 700; letter-spacing: -0.01em;
    background-color: rgba(230, 46, 69, 0.14);
    border: 1px solid rgba(230, 46, 69, 0.42);
    color: var(--accent-red);
  }
  .masthead-meta { display: flex; align-items: center; gap: 10px; font-size: 13.5px; font-weight: 700; color: var(--text-soft); }
  .masthead-meta .sep { color: var(--draw-grey); }
  .meta-stadium { display: inline-flex; align-items: center; gap: 6px; color: #FFFFFF; }
  .pill-broadcast {
    padding: 2px 10px; border-radius: 999px;
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.35);
    color: var(--emerald-bright);
    font-size: 12.5px; font-weight: 800;
  }
  #card-brand-logo { display: flex; align-items: center; gap: 14px; flex-shrink: 0; }
  .masthead-lockup { display: flex; align-items: center; gap: 14px; }
  .lockup-text { display: flex; flex-direction: column; line-height: 1; }
  .lockup-brand { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 34px; letter-spacing: -0.02em; }
  .lockup-sub { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; margin-top: 4px; }

  /* ── بدنهٔ اصلی ── */
  #card-main-body {
    position: relative; z-index: 10;
    flex: 1; padding: 8px 36px;
    display: flex; flex-direction: column; justify-content: space-between; gap: 12px;
    overflow: hidden;
  }
  #card-hero-section { display: flex; flex-direction: column; justify-content: space-between; flex-shrink: 0; }
  .matchup-grid { display: grid; grid-template-columns: repeat(11, 1fr); align-items: center; gap: 8px; }
  .team-col { grid-column: span 4; display: flex; flex-direction: column; align-items: center; text-align: center; }
  .hub-col { grid-column: span 3; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 0 4px; }
  .crest-wrap { position: relative; width: 184px; height: 184px; display: flex; align-items: center; justify-content: center; margin-bottom: 6px; }
  .crest-slot { position: relative; z-index: 10; display: flex; align-items: center; justify-content: center; }
  .crest-img { width: 178px; height: 178px; object-fit: contain; filter: drop-shadow(0 16px 26px rgba(0,0,0,0.6)); }
  .team-name { font-size: 40px; font-weight: 900; color: #FFFFFF; line-height: 1.1; letter-spacing: -0.02em; }
  .team-sub { font-size: 16px; font-weight: 700; color: rgba(226, 232, 240, 0.85); margin-top: 6px; max-width: 310px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .team-form { display: flex; align-items: center; gap: 6px; margin-top: 10px; }

  .laser-top { width: 2px; height: 36px; background: linear-gradient(to bottom, transparent, var(--accent-red)); }
  .laser-bottom { width: 2px; height: 24px; margin: 6px 0; background: linear-gradient(to top, transparent, var(--accent-red)); }
  .vs-wrap { position: relative; margin: 8px 0; display: flex; align-items: center; justify-content: center; }
  .vs-diamond {
    width: 84px; height: 84px; border-radius: 22px; transform: rotate(45deg);
    background: var(--accent-red);
    box-shadow: 0 0 40px rgba(230, 46, 69, 0.55);
    border: 2px solid rgba(255, 255, 255, 0.3);
  }
  .vs-label { position: absolute; font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 35px; color: #FFFFFF; letter-spacing: -0.05em; }
  .xg-hub { width: 100%; padding: 10px; border-radius: 16px; background: var(--bg-deep-90); border: 1px solid rgba(255, 255, 255, 0.14); box-shadow: 0 20px 25px -5px rgba(0,0,0,0.2), 0 8px 10px -6px rgba(0,0,0,0.2); }
  .xg-hub-row { display: flex; align-items: center; justify-content: center; gap: 10px; }
  .xg-hub-val { font-size: 32px; font-weight: 900; line-height: 1; }
  .xg-hub-label { font-size: 14px; font-weight: 900; color: var(--text-slate); font-family: 'JetBrains Mono', monospace; }
  .xg-hub-sub { margin-top: 8px; padding-top: 6px; border-top: 1px solid rgba(255,255,255,0.1); display: flex; align-items: center; justify-content: space-around; font-size: 11px; }
  .xg-hub-sub .cell-label { color: var(--text-slate); display: block; font-size: 9.5px; }
  .xg-hub-sub strong { font-weight: 800; color: #FFFFFF; }
  .xg-hub-sub .vsep { height: 16px; width: 1px; background: rgba(255,255,255,0.1); }
  .xg-hub-sub .total { color: var(--emerald-bright); font-weight: 800; }

  .capsule-block { margin-top: 32px; }
  .odds-row { position: relative; width: 100%; height: 28px; display: flex; align-items: center; justify-content: space-between; padding: 0 4px; font-size: 12px; font-weight: 800; }
  .odds-side { display: flex; align-items: center; gap: 6px; z-index: 10; }
  .odds-side .lbl { color: var(--text-slate); }
  .odds-chip { font-size: 14px; font-weight: 900; padding: 2px 8px; border-radius: 6px; background: rgba(255, 255, 255, 0.06); }
  #odds-draw-anchor { position: absolute; top: 50%; transform: translate(50%, -50%); display: flex; align-items: center; gap: 6px; white-space: nowrap; z-index: 10; transition: all 0.2s; }
  #odds-draw-anchor .lbl { color: var(--text-slate); }

  /* ── شبکهٔ ماژول‌ها ── */
  #modules-grid { flex: 1; display: grid; grid-template-columns: 1fr 1fr; gap: 14px; align-content: stretch; min-height: 0; }
  .span-full { grid-column: span 2; }
  .span-half { grid-column: span 1; }

  .mod-head { display: flex; align-items: center; justify-content: space-between; padding-bottom: 6px; margin-bottom: 6px; border-bottom: 1px solid rgba(255,255,255,0.1); }
  .mod-head-l { display: flex; align-items: center; gap: 8px; }
  .mod-chip { width: 6px; height: 20px; border-radius: 999px; background: var(--accent-red); flex-shrink: 0; }
  .mod-chip.emerald { background: var(--emerald-bright); }
  .mod-chip.amber { background: var(--amber); }
  .mod-title { font-size: 17px; font-weight: 900; color: #FFFFFF; }
  .mod-tag { font-size: 11px; font-family: 'JetBrains Mono', monospace; color: var(--text-slate); }
  .mod-tag.emerald { color: var(--emerald-bright); }
  .mod-tag.amber { color: rgba(251, 191, 36, 0.9); font-family: 'Vazirmatn', sans-serif; }

  /* stats */
  .stats-body { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 8px; }
  .stat-line { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; }
  .stat-val { font-size: 21px; font-weight: 900; line-height: 1; }
  .stat-val.home { text-align: right; }
  .stat-val.away { text-align: left; }
  .stat-label { text-align: center; font-size: 14px; font-weight: 700; color: var(--text-soft); }
  .stat-bars { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; margin-top: 4px; }

  /* radar / wave / trend */
  .chart-wrap { flex: 1; display: flex; align-items: center; justify-content: center; }
  .chart-wrap.ltr { direction: ltr; }

  /* focus (editorial) */
  .editorial-bg-svg { position: absolute; left: 12px; bottom: 12px; width: 128px; opacity: 0.13; pointer-events: none; }
  .editorial-inner { position: relative; z-index: 10; }
  .focus-title { font-size: 16px; font-weight: 900; color: var(--amber-soft); margin-bottom: 6px; }
  .focus-body { font-size: 14.5px; line-height: 1.625; color: var(--text-soft); font-weight: 500; }
  .focus-foot { position: relative; z-index: 10; margin-top: 8px; padding-top: 8px; border-top: 1px solid rgba(255,255,255,0.1); display: flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 700; color: var(--text-line); }
  .focus-foot .dot { width: 8px; height: 8px; border-radius: 999px; background: var(--accent-red); }

  /* watchout (editorial) */
  .watch-block { padding: 10px; border-radius: 12px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); }
  .watch-block .watch-team { font-size: 12px; font-weight: 800; margin-bottom: 2px; }
  .watch-block p { font-size: 13.5px; color: var(--text-soft); line-height: 1.375; font-weight: 500; }
  .watch-list { display: flex; flex-direction: column; gap: 8px; }

  /* keyduel */
  .duel-grid { display: grid; grid-template-columns: repeat(11, 1fr); align-items: center; gap: 8px; margin: auto 0; }
  .duel-card { grid-column: span 5; padding: 12px; border-radius: 16px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); display: flex; flex-direction: column; gap: 6px; }
  .duel-row1 { display: flex; align-items: center; justify-content: space-between; gap: 4px; }
  .duel-name { font-size: 16px; font-weight: 900; color: #FFFFFF; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .duel-pos { font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 6px; background: rgba(255,255,255,0.1); color: var(--text-line); flex-shrink: 0; }
  .duel-row2 { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 4px; font-size: 12px; padding-top: 6px; border-top: 1px solid rgba(255,255,255,0.1); }
  .duel-vs { grid-column: span 1; display: flex; align-items: center; justify-content: center; }
  .duel-vs span { width: 32px; height: 32px; border-radius: 12px; background: rgba(230,46,69,0.2); border: 1px solid rgba(230,46,69,0.5); display: flex; align-items: center; justify-content: center; font-family: 'JetBrains Mono', monospace; font-size: 12px; font-weight: 800; color: var(--duel-vs-red); }

  /* poisson */
  .poisson-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 4px; }
  .pm-axis { display: flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 700; color: var(--text-slate); }
  .pm-head { display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 900; }
  .pm-cell { border-radius: 8px; padding: 4px 0; text-align: center; border: 1px solid rgba(255,255,255,0.1); }
  .pm-cell .sc { font-size: 10px; font-weight: 700; opacity: 0.8; line-height: 1; }
  .pm-cell .pc { font-size: 12px; font-weight: 900; margin-top: 2px; line-height: 1; }
  .poisson-foot { margin-top: 8px; padding-top: 6px; border-top: 1px solid rgba(255,255,255,0.1); display: flex; align-items: center; justify-content: space-between; font-size: 12px; }
  .poisson-foot .lbl { color: var(--text-slate); font-weight: 700; }
  .poisson-foot strong { color: var(--emerald-bright); font-weight: 800; }

  /* signals */
  .signals-grid { display: grid; gap: 12px; }
  .signals-grid.cols-3 { grid-template-columns: repeat(3, 1fr); }
  .signals-grid.cols-2 { grid-template-columns: repeat(2, 1fr); }
  .signal-card { border-radius: 16px; padding: 10px 12px; display: flex; align-items: center; justify-content: space-between; gap: 8px; border: 1px solid; }
  .signal-card.tone-emerald { background: linear-gradient(to left, rgba(16,185,129,0.15), rgba(255,255,255,0.03)); border-color: rgba(16,185,129,0.3); border-right: 4px solid var(--emerald); }
  .signal-card.tone-sky { background: linear-gradient(to left, rgba(56,189,248,0.15), rgba(255,255,255,0.03)); border-color: rgba(56,189,248,0.3); border-right: 4px solid var(--sky-bright); }
  .signal-card.tone-amber { background: linear-gradient(to left, rgba(245,158,11,0.15), rgba(255,255,255,0.03)); border-color: rgba(245,158,11,0.3); border-right: 4px solid var(--amber); }
  .signal-badge { display: inline-block; font-family: 'JetBrains Mono', monospace; font-size: 11px; font-weight: 800; padding: 2px 8px; border-radius: 6px; margin-bottom: 4px; }
  .signal-card.tone-emerald .signal-badge { background: rgba(16,185,129,0.25); color: var(--emerald-bright); }
  .signal-card.tone-sky .signal-badge { background: rgba(56,189,248,0.25); color: var(--sky-bright-light); }
  .signal-card.tone-amber .signal-badge { background: rgba(245,158,11,0.25); color: var(--amber-bright); }
  .signal-title { font-size: 14px; font-weight: 900; color: #FFFFFF; }
  .signal-desc { font-size: 11px; color: var(--text-line); margin-top: 2px; }
  .signal-value { font-size: 22px; font-weight: 900; line-height: 1; }
  .signal-card.tone-emerald .signal-value { color: var(--emerald-bright); }
  .signal-card.tone-sky .signal-value { color: var(--sky-bright-light); }
  .signal-card.tone-amber .signal-value { color: var(--amber-bright); }

  /* ── پانویس پخش ── */
  #card-footer {
    position: relative; z-index: 10;
    padding: 14px 36px;
    border-top: 1px solid rgba(255,255,255,0.12);
    background: rgba(0, 0, 0, 0.25);
    display: flex; align-items: center; justify-content: space-between;
    font-size: 12px; color: var(--text-slate);
    flex-shrink: 0;
  }
  .footer-left { display: flex; align-items: center; gap: 8px; }
  .footer-dot { width: 8px; height: 8px; border-radius: 999px; background: var(--accent-red); }
  .footer-tag { font-family: 'JetBrains Mono', monospace; font-size: 13px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(226, 232, 240, 0.9); }
  .footer-right { display: flex; align-items: center; gap: 12px; font-family: 'JetBrains Mono', monospace; font-weight: 700; color: var(--text-line); direction: ltr; }
  .footer-source { color: var(--text-slate); font-weight: 500; font-size: 11px; }
  .footer-right .sep { color: var(--draw-grey); }

  /* ── چیدمان ۱۶:۹ — hero کنار و ماژول‌ها ستون دیگر (عین کلاس‌سوئیچ استودیو) ── */
  .fmt-169 #card-main-body { display: grid; grid-template-columns: repeat(12, 1fr); gap: 32px; align-items: stretch; padding: 8px 36px; }
  .fmt-169 #card-hero-section { grid-column: span 5; border-left: 1px solid rgba(255,255,255,0.1); padding-left: 28px; }
  .fmt-169 #modules-grid { grid-column: span 7; }
  .fmt-916 #card-main-body { padding: 24px 36px; gap: 24px; }
  .fmt-916 #modules-grid { gap: 16px; }
</style>
</head>
<body>
<div id="export-artboard" dir="rtl" class="fmt-{{ '169' if format.is_wide else ('916' if format.is_tall else '45') }}">

  <!-- لایهٔ ۱: نورپردازی محیطی دو تیم -->
  <div id="card-ambient-glow"></div>

  <!-- لایهٔ ۲: خط‌کشی زمین و قاب محیطی -->
  <svg id="card-pitch-svg" viewBox="0 0 {{ format.w }} {{ format.h }}" preserveAspectRatio="xMidYMid slice" fill="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <pattern id="techGridPattern" width="54" height="54" patternUnits="userSpaceOnUse">
        <path d="M 54 0 L 0 0 0 54" fill="none" stroke="#F8FAFC" stroke-opacity="0.055" stroke-width="1" />
      </pattern>
      <radialGradient id="radarFadeGrad" cx="50%" cy="30%" r="44%">
        <stop offset="0%" stop-color="#E62E45" stop-opacity="0.22" />
        <stop offset="55%" stop-color="#E62E45" stop-opacity="0.06" />
        <stop offset="100%" stop-color="#E62E45" stop-opacity="0" />
      </radialGradient>
    </defs>
    <rect width="100%" height="100%" fill="url(#techGridPattern)" />
    <rect x="12" y="12" width="{{ format.w - 24 }}" height="{{ format.h - 24 }}" rx="18" stroke="#F8FAFC" stroke-opacity="0.11" stroke-width="1.5" />
    <line x1="{{ format.w // 2 }}" y1="12" x2="{{ format.w // 2 }}" y2="{{ format.h - 12 }}" stroke="#F8FAFC" stroke-opacity="0.09" stroke-width="1.5" stroke-dasharray="8 8" />
    <circle cx="540" cy="315" r="145" stroke="#F8FAFC" stroke-opacity="0.09" stroke-width="1.5" />
    <rect x="12" y="145" width="135" height="360" stroke="#F8FAFC" stroke-opacity="0.07" stroke-width="1.5" />
    <path d="M147 245 A 95 95 0 0 1 147 405" stroke="#F8FAFC" stroke-opacity="0.07" stroke-width="1.5" />
    <rect x="{{ pitch.right_box_x }}" y="145" width="135" height="360" stroke="#F8FAFC" stroke-opacity="0.07" stroke-width="1.5" />
    <path d="{{ pitch.right_arc }}" stroke="#F8FAFC" stroke-opacity="0.07" stroke-width="1.5" />
    <circle cx="540" cy="315" r="245" fill="url(#radarFadeGrad)" />
    <circle cx="540" cy="315" r="215" stroke="#E62E45" stroke-opacity="0.18" stroke-width="1.2" stroke-dasharray="4 6" />
    <circle cx="540" cy="315" r="295" stroke="#F8FAFC" stroke-opacity="0.07" stroke-width="1" />
    <circle cx="540" cy="315" r="375" stroke="#F8FAFC" stroke-opacity="0.045" stroke-width="1" />
    <path d="{{ pitch.crosshairs }}" stroke="#E62E45" stroke-opacity="0.55" stroke-width="2" />
  </svg>

  <!-- لایهٔ ۳: خطوط اسکن پخش -->
  <div class="broadcast-scanlines"></div>

  <!-- ۱. سرصفحه -->
  <header id="card-masthead">
    <div class="masthead-left">
      <div class="masthead-pills">
        <div class="pill-competition">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#E62E45" stroke-width="2.3">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 21h8m-4-4v4m-5-17h10v5a5 5 0 01-10 0V4zM5 6H3v2a3 3 0 003 3h1m12-5h2v2a3 3 0 01-3 3h-1" />
          </svg>
          <span>{{ competition_fa }}</span>
        </div>
        {% if round %}<span class="pill-round">{{ round }}</span>{% endif %}
      </div>
      <div class="masthead-meta">
        <span>{{ day }}{% if time %} • {{ time }}{% endif %}</span>
        {% if stadium %}
        <span class="sep">|</span>
        <span class="meta-stadium">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#E62E45" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <ellipse cx="12" cy="8" rx="9" ry="3.5" />
            <path d="M3 8v6c0 1.93 4.03 3.5 9 3.5s9-1.57 9-3.5V8" />
            <path d="M7 11.2v5.8M12 11.5v6M17 11.2v5.8" />
            <path d="M6 4.8V3M18 4.8V3" />
          </svg>
          <span>{{ stadium }}</span>
        </span>
        {% endif %}
        {% if broadcast %}
        <span class="sep">|</span>
        <span class="pill-broadcast">{{ broadcast }}</span>
        {% endif %}
      </div>
    </div>
    <div id="card-brand-logo">{{ brand_lockup_html | safe }}</div>
  </header>

  <!-- ۲. بدنهٔ اصلی -->
  <div id="card-main-body">
    <section id="card-hero-section">
      <div class="matchup-grid">

        <!-- میزبان (راست) -->
        <div class="team-col">
          <div class="crest-wrap"><div class="crest-slot">{{ home.crest_html | safe }}</div></div>
          <h1 class="team-name">{{ home.name_fa }}</h1>
          {% if home.sub %}<p class="team-sub">{{ home.sub }}</p>{% endif %}
          {% if home.form_dots %}
          <div class="team-form">
            {% for d in home.form_dots %}<span class="form-dot form-{{ d.f }}">{{ d.label }}</span>{% endfor %}
          </div>
          {% endif %}
        </div>

        <!-- مرکز: VS + هاب xG -->
        <div class="hub-col">
          <div class="laser-top"></div>
          <div class="vs-wrap">
            <div class="vs-diamond"></div>
            <span class="vs-label">VS</span>
          </div>
          <div class="laser-bottom"></div>
          <div class="xg-hub">
            {% if hero.xg_home and hero.xg_away %}
            <div class="xg-hub-row">
              <span class="xg-hub-val" style="color: var(--home-color);">{{ hero.xg_home }}</span>
              <span class="xg-hub-label">xG</span>
              <span class="xg-hub-val" style="color: var(--away-color);">{{ hero.xg_away }}</span>
            </div>
            {% if hero.xpts_home %}
            <div class="xg-hub-sub">
              <div><span class="cell-label">امتیاز انتظاری</span><strong>{{ hero.xpts_home }} xPts</strong></div>
              <div class="vsep"></div>
              <div><span class="cell-label">مجموع xG بازی</span><span class="total">{{ hero.xg_total }}</span></div>
              <div class="vsep"></div>
              <div><span class="cell-label">امتیاز انتظاری</span><strong>{{ hero.xpts_away }} xPts</strong></div>
            </div>
            {% endif %}
            {% else %}
            <div class="xg-hub-row"><span class="pm-axis">{{ na_label }}</span></div>
            {% endif %}
          </div>
        </div>

        <!-- میهمان (چپ) -->
        <div class="team-col">
          <div class="crest-wrap"><div class="crest-slot">{{ away.crest_html | safe }}</div></div>
          <h2 class="team-name">{{ away.name_fa }}</h2>
          {% if away.sub %}<p class="team-sub">{{ away.sub }}</p>{% endif %}
          {% if away.form_dots %}
          <div class="team-form">
            {% for d in away.form_dots %}<span class="form-dot form-{{ d.f }}">{{ d.label }}</span>{% endfor %}
          </div>
          {% endif %}
        </div>
      </div>

      <!-- کپسول احتمال + ضرایب منصفانه -->
      {% if hero.capsule %}
      <div class="capsule-block">
        <div class="prob-capsule">
          {% for seg in hero.capsule %}
          <div class="prob-seg" style="width: {{ seg.pct }}%; background: {{ seg.bg }}; color: {{ seg.color }};">{% if seg.pct >= 11 %}{{ seg.pct }}٪{% endif %}</div>
          {% endfor %}
        </div>
        <div class="odds-row">
          <div class="odds-side">
            <span class="lbl">ضریب منصفانه میزبان:</span>
            <span class="odds-chip" style="color: var(--home-color);">{{ hero.odds.home }}</span>
          </div>
          <div id="odds-draw-anchor" style="right: {{ hero.odds.draw_anchor_pct }}%; transform: translate(50%, -50%);">
            <span class="lbl">ضریب مساوی:</span>
            <span class="odds-chip" style="color: var(--text-soft);">{{ hero.odds.draw }}</span>
          </div>
          <div class="odds-side">
            <span class="lbl">ضریب منصفانه میهمان:</span>
            <span class="odds-chip" style="color: var(--away-color);">{{ hero.odds.away }}</span>
          </div>
        </div>
      </div>
      {% endif %}
    </section>

    <!-- ۳. شبکهٔ ماژولار -->
    <section id="modules-grid">
      {% for mod in modules if mod.enabled %}
      {% set data = module_data[mod.id] %}
      {% set span_cls = 'span-full' if mod.span == 'full' else 'span-half' %}

      {# ── A. مقایسهٔ شاخص‌ها — میله‌های تخت متناسب ── #}
      {% if mod.id == 'stats' %}
      <div class="xg-glass-card {{ span_cls }}">
        <div class="mod-head">
          <div class="mod-head-l"><span class="mod-chip"></span><h3 class="mod-title">مقایسه شاخص‌های کلیدی (به ازای ۹۰ دقیقه)</h3></div>
          {% if data.n %}<span class="mod-tag">{{ data.n }}</span>{% endif %}
        </div>
        <div class="stats-body">
          {% for r in data.rows %}
          <div class="stat-row">
            <div class="stat-line">
              <span class="stat-val home" style="color: var(--home-color);">{{ r.h }}</span>
              <span class="stat-label">{{ r.label }}</span>
              <span class="stat-val away" style="color: var(--away-color);">{{ r.a }}</span>
            </div>
            <div class="stat-bars">
              <div class="comp-bar-track home-side"><div class="comp-bar-fill-home" style="width: {{ r.h_pct }}%; background: var(--home-color);"></div></div>
              <div class="comp-bar-track away-side"><div class="comp-bar-fill-away" style="width: {{ r.a_pct }}%; background: var(--away-color);"></div></div>
            </div>
          </div>
          {% endfor %}
        </div>
      </div>
      {% endif %}

      {# ── B. رادار ۶ محوره (کد محفوظ — با دادهٔ صدک فعال می‌شود) ── #}
      {% if mod.id == 'radar' %}
      <div class="xg-glass-card {{ span_cls }}">
        <div class="mod-head">
          <div class="mod-head-l"><span class="mod-chip"></span><h3 class="mod-title">رادار ۶ محوره تاکتیکی</h3></div>
          <span class="mod-tag">PERCENTILE</span>
        </div>
        <div class="chart-wrap ltr">
          <svg width="100%" height="224" viewBox="0 0 {{ data.vb_w }} {{ data.vb_h }}" fill="none">
            <g stroke="rgba(255,255,255,0.14)" stroke-width="1.2">
              {% for ring in data.rings %}<polygon points="{{ ring }}" />{% endfor %}
              {% for ax in data.axes %}<line x1="{{ ax.split(' ')[0] }}" y1="{{ ax.split(' ')[1] }}" x2="{{ ax.split(' ')[2] }}" y2="{{ ax.split(' ')[3] }}" />{% endfor %}
            </g>
            <polygon points="{{ data.away_poly }}" fill="{{ away.color }}" fill-opacity="0.24" stroke="{{ away.color }}" stroke-width="2.5" />
            <polygon points="{{ data.home_poly }}" fill="{{ home.color }}" fill-opacity="0.30" stroke="{{ home.color }}" stroke-width="2.8" />
            {% for d in data.home_dots %}<circle cx="{{ d.x }}" cy="{{ d.y }}" r="3.4" fill="#FFFFFF" />{% endfor %}
            {% for lbl in data.labels %}
            <g>
              <text x="{{ lbl.x }}" y="{{ lbl.y }}" text-anchor="{{ lbl.anchor }}" fill="{{ palette.text_body }}" font-family="Vazirmatn" font-weight="800" font-size="13.5">{{ lbl.label }}</text>
              <text x="{{ lbl.x }}" y="{{ lbl.y2 }}" text-anchor="{{ lbl.anchor }}" font-family="Vazirmatn" font-weight="900" font-size="13">
                <tspan fill="{{ lbl.hc }}">{{ lbl.hv }}</tspan><tspan fill="{{ palette.text_muted }}"> / </tspan><tspan fill="{{ lbl.ac }}">{{ lbl.av }}</tspan>
              </text>
            </g>
            {% endfor %}
          </svg>
        </div>
      </div>
      {% endif %}

      {# ── C. نقطهٔ تمرکز بازی — کارت تحریریه ── #}
      {% if mod.id == 'focus' %}
      <div class="xg-tactical-editorial {{ span_cls }}">
        <svg class="editorial-bg-svg" viewBox="0 0 240 160" fill="none" stroke="#DCE6F8" stroke-width="2.5">
          <rect x="2" y="2" width="236" height="156" rx="6" />
          <line x1="120" y1="2" x2="120" y2="158" />
          <circle cx="120" cy="80" r="32" />
          <rect x="2" y="42" width="36" height="76" />
          <rect x="202" y="42" width="36" height="76" />
        </svg>
        <div class="editorial-inner">
          <div class="mod-head">
            <div class="mod-head-l"><span class="mod-chip"></span><h3 class="mod-title">نقطهٔ تمرکز بازی</h3></div>
            <span class="mod-tag">TACTICAL LENS</span>
          </div>
          <h4 class="focus-title">{{ data.title }}</h4>
          {% for line in data.body_lines %}<p class="focus-body">{{ line }}</p>{% endfor %}
        </div>
        {% if data.tag %}
        <div class="focus-foot"><span class="dot"></span><span>{{ data.tag }}</span></div>
        {% endif %}
      </div>
      {% endif %}

      {# ── D. باید حواسشون بهش باشه (کد محفوظ — با دادهٔ هشدار تیم فعال می‌شود) ── #}
      {% if mod.id == 'watchout' %}
      <div class="xg-tactical-editorial {{ span_cls }}">
        <svg class="editorial-bg-svg" style="width: 112px;" viewBox="0 0 140 140" fill="none" stroke="#F59E0B" stroke-width="2.2">
          <circle cx="70" cy="70" r="60" />
          <circle cx="70" cy="70" r="38" stroke-dasharray="6 5" />
          <line x1="70" y1="6" x2="70" y2="134" />
          <line x1="6" y1="70" x2="134" y2="70" />
        </svg>
        <div class="editorial-inner">
          <div class="mod-head">
            <div class="mod-head-l"><span class="mod-chip amber"></span><h3 class="mod-title">باید حواسشون بهش باشه</h3></div>
            <span class="mod-tag amber">WATCHLIST</span>
          </div>
          <div class="watch-list">
            <div class="watch-block" style="border-right: 4px solid var(--home-color);">
              <div class="watch-team" style="color: var(--home-color);">هشدار برای {{ home.name_fa }}:</div>
              <p>{{ data.home_text }}</p>
            </div>
            <div class="watch-block" style="border-right: 4px solid var(--away-color);">
              <div class="watch-team" style="color: var(--away-color);">هشدار برای {{ away.name_fa }}:</div>
              <p>{{ data.away_text }}</p>
            </div>
          </div>
        </div>
      </div>
      {% endif %}

      {# ── E. تقابل مهره‌های کلیدی (کد محفوظ — با پک آمار بازیکن فعال می‌شود) ── #}
      {% if mod.id == 'keyduel' %}
      <div class="xg-glass-card {{ span_cls }}">
        <div class="mod-head">
          <div class="mod-head-l"><span class="mod-chip"></span><h3 class="mod-title">تقابل مهره‌های کلیدی</h3></div>
          <span class="mod-tag">KEY PLAYER DUEL</span>
        </div>
        <div class="duel-grid">
          <div class="duel-card" style="border-right: 4px solid var(--home-color);">
            <div class="duel-row1">
              <span class="duel-name">{{ data.home.name }}</span>
              <span class="duel-pos">{{ data.home.pos }}</span>
            </div>
            <div class="duel-row2">
              <span style="color: var(--home-color); font-weight: 800;">{{ data.home.s1 }}</span>
              <span style="color: var(--text-line); font-weight: 700;">{{ data.home.s2 }}</span>
            </div>
          </div>
          <div class="duel-vs"><span>VS</span></div>
          <div class="duel-card" style="border-right: 4px solid var(--away-color);">
            <div class="duel-row1">
              <span class="duel-name">{{ data.away.name }}</span>
              <span class="duel-pos">{{ data.away.pos }}</span>
            </div>
            <div class="duel-row2">
              <span style="color: var(--away-color); font-weight: 800;">{{ data.away.s1 }}</span>
              <span style="color: var(--text-line); font-weight: 700;">{{ data.away.s2 }}</span>
            </div>
          </div>
        </div>
      </div>
      {% endif %}

      {# ── F. ماتریس پواسون ۵×۵ — از xG واقعی ── #}
      {% if mod.id == 'poisson' %}
      <div class="xg-glass-card {{ span_cls }}">
        <div class="mod-head">
          <div class="mod-head-l"><span class="mod-chip"></span><h3 class="mod-title">ماتریس احتمال دقیق نتیجه</h3></div>
          <span class="mod-tag" style="font-family: 'Vazirmatn', sans-serif;">مدل پواسون ۵×۵</span>
        </div>
        <div class="poisson-grid">
          <div class="pm-axis">م\م</div>
          {% for a in range(5) %}<div class="pm-head" style="color: {{ data.col_ac }};">{{ a }}</div>{% endfor %}
          {% for h in range(5) %}
          <div class="pm-head" style="color: {{ data.col_hc }};">{{ h }}</div>
          {% for a in range(5) %}
          {% set c = data.cells[h * 5 + a] %}
          <div class="pm-cell" style="background: {{ c.bg }};">
            <div class="sc">{{ c.score }}</div>
            <div class="pc">{{ c.pct }}٪</div>
          </div>
          {% endfor %}
          {% endfor %}
        </div>
        <div class="poisson-foot">
          <span class="lbl">محتمل‌ترین نتایج:</span>
          <strong>{{ data.top3 }}</strong>
        </div>
      </div>
      {% endif %}

      {# ── G. موج زمانی xG (کد محفوظ — با دیتای رویدادی فعال می‌شود) ── #}
      {% if mod.id == 'wave' %}
      <div class="xg-glass-card {{ span_cls }}">
        <div class="mod-head">
          <div class="mod-head-l"><span class="mod-chip"></span><h3 class="mod-title">موج زمانی امید گل (xG)</h3></div>
          <span class="mod-tag" style="font-family: 'Vazirmatn', sans-serif;">بازه‌های ۱۵ دقیقه‌ای</span>
        </div>
        <div class="chart-wrap ltr">
          <svg width="100%" height="154" viewBox="0 0 {{ data.w }} {{ data.h + 24 }}" fill="none">
            <defs>
              <linearGradient id="waveGrad_{{ mod.span }}" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="{{ home.color }}" stop-opacity="0.38" />
                <stop offset="100%" stop-color="{{ home.color }}" stop-opacity="0.0" />
              </linearGradient>
            </defs>
            <g stroke="rgba(255,255,255,0.08)" stroke-width="1" stroke-dasharray="4 4">
              {% for g in data.grid %}<line x1="{{ g.split(' ')[0] }}" y1="{{ g.split(' ')[1] }}" x2="{{ g.split(' ')[2] }}" y2="{{ g.split(' ')[3] }}" />{% endfor %}
            </g>
            <path d="{{ data.area_path }}" fill="url(#waveGrad_{{ mod.span }})" />
            <path d="{{ data.away_path }}" stroke="{{ away.color }}" stroke-width="2.8" fill="none" stroke-linecap="round" />
            <path d="{{ data.home_path }}" stroke="{{ home.color }}" stroke-width="3.2" fill="none" stroke-linecap="round" />
            {% for d in data.dots %}
            <circle cx="{{ d.x }}" cy="{{ d.y }}" r="4" fill="{{ home.color }}" stroke="#FFFFFF" stroke-width="1.5" />
            <text x="{{ d.x }}" y="{{ data.h + 17 }}" text-anchor="middle" fill="{{ palette.text_slate }}" font-family="Vazirmatn" font-weight="800" font-size="13">{{ d.m }}</text>
            {% endfor %}
          </svg>
        </div>
      </div>
      {% endif %}

      {# ── H. روند xG در ۱۰ بازی اخیر — از fact_json (xg_series) ── #}
      {% if mod.id == 'trend10' %}
      <div class="xg-glass-card {{ span_cls }}">
        <div class="mod-head">
          <div class="mod-head-l"><span class="mod-chip"></span><h3 class="mod-title">روند xG در بازی‌های اخیر</h3></div>
          <div style="font-size: 12px; font-weight: 800;">
            <span style="color: {{ home.color }};">{{ data.home_avg }}</span>
            <span style="color: {{ palette.text_muted }}; margin: 0 4px;">/</span>
            <span style="color: {{ away.color }};">{{ data.away_avg }}</span>
          </div>
        </div>
        <div class="chart-wrap ltr">
          <svg width="100%" height="154" viewBox="0 0 {{ data.w }} {{ data.h + 24 }}" fill="none">
            <g stroke="rgba(255,255,255,0.08)" stroke-width="1" stroke-dasharray="4 4">
              <line x1="{{ data.grid_top.split(' ')[0] }}" y1="{{ data.grid_top.split(' ')[1] }}" x2="{{ data.grid_top.split(' ')[2] }}" y2="{{ data.grid_top.split(' ')[3] }}" />
              <line x1="{{ data.grid_bottom.split(' ')[0] }}" y1="{{ data.grid_bottom.split(' ')[1] }}" x2="{{ data.grid_bottom.split(' ')[2] }}" y2="{{ data.grid_bottom.split(' ')[3] }}" />
            </g>
            <path d="{{ data.away_path }}" stroke="{{ away.color }}" stroke-width="2.8" fill="none" stroke-linecap="round" />
            <path d="{{ data.home_path }}" stroke="{{ home.color }}" stroke-width="3.2" fill="none" stroke-linecap="round" />
            {% for d in data.home_dots %}
            <circle cx="{{ d.x }}" cy="{{ d.y }}" r="3.6" fill="{{ home.color }}" stroke="#FFFFFF" stroke-width="1.3" />
            <text x="{{ d.x }}" y="{{ data.h + 17 }}" text-anchor="middle" fill="{{ palette.text_slate }}" font-family="Vazirmatn" font-weight="700" font-size="12">{{ d.i }}</text>
            {% endfor %}
          </svg>
        </div>
      </div>
      {% endif %}

      {# ── I. سیگنال‌های آماری — احتمال‌های مشتق Dixon-Coles؛ badge EV فقط با دادهٔ ضریب ── #}
      {% if mod.id == 'signals' %}
      <div class="xg-glass-card {{ span_cls }}">
        <div class="mod-head">
          <div class="mod-head-l"><span class="mod-chip emerald"></span><h3 class="mod-title">سیگنال‌های آماری و ارزش بازار (+EV)</h3></div>
          <span class="mod-tag emerald">VALUE EDGE</span>
        </div>
        <div class="signals-grid {{ 'cols-3' if data.cards | length >= 3 else 'cols-2' }}">
          {% for card in data.cards %}
          <div class="signal-card tone-{{ card.tone }}">
            <div>
              {% if card.badge %}<span class="signal-badge" dir="ltr">{{ card.badge }} EV</span>{% endif %}
              <div class="signal-title">{{ card.title }}</div>
              <div class="signal-desc">{{ card.desc }}</div>
            </div>
            <div class="signal-value">{{ card.value }}٪</div>
          </div>
          {% endfor %}
        </div>
      </div>
      {% endif %}

      {% endfor %}
    </section>
  </div>

  <!-- ۳. پانویس پخش -->
  <footer id="card-footer">
    <div class="footer-left">
      <span class="footer-dot"></span>
      <span class="footer-tag" dir="ltr">{{ micro_tag }}</span>
    </div>
    <div class="footer-right">
      <span>{{ handle }}</span>
      <span class="sep">•</span>
      <span>{{ domain }}</span>
      <span class="sep">|</span>
      <span class="footer-source">{{ source_label }}</span>
    </div>
  </footer>
</div>
</body>
</html>
