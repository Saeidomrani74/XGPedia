{# قالب کارت پس‌از‌بازی — استودیوی post-match.html، تم «مجله تاکتیکی خاکی و برنز» (Warm Terracotta) عیناً #}
{# منبع طراحی: فایل استودیو؛ همهٔ رنگ‌ها از brand.json (postmatch_palette) و رنگ تیم‌ها از
   config/team_identities.json تزریق می‌شود — هیچ هگز برندی در قالب هاردکد نیست.
   اعداد از fact_json (result/match_stats)؛ متن‌ها از draft_json؛ مشتق‌ها فقط Dixon-Coles.
   ماژول‌ها: stats/trend10/story/shotquality/verdict (+motm/momentum رزرو)؛
   ماژول یا ردیفی که داده‌اش نیست رندر نمی‌شود (null≠0). #}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="utf-8">
<title>XGPedia | {{ home.name_fa }} {{ score.home }}-{{ score.away }} {{ away.name_fa }}</title>
{% if brand_favicon_uri %}<link rel="icon" type="image/svg+xml" href="{{ brand_favicon_uri }}">
{% endif %}<style>
  {% for f in fonts %}
  @font-face { font-family: '{{ f.family }}'; src: url('{{ f.data }}') format('woff2'); font-weight: {{ f.weight }}; }
  {% endfor %}

  :root {
    --t-board-bg: {{ t.board_bg }};
    --t-accent: {{ t.accent }};
    --t-accent-contrast: {{ t.accent_contrast }};
    --t-card-bg: {{ t.card_bg }};
    --t-card-border: {{ t.card_border }};
    --t-card-shadow: {{ t.card_shadow }};
    --t-editorial-bg: {{ t.editorial_bg }};
    --t-editorial-border: {{ t.editorial_border }};
    --t-xgbox-bg: {{ t.xgbox_bg }};
    --t-text-main: {{ t.text_main }};
    --t-text-sub: {{ t.text_sub }};
    --t-text-muted: {{ t.text_muted }};
    --t-surface: {{ t.surface }};
    --t-track-bg: {{ t.track_bg }};
    --t-capsule-bg: {{ t.capsule_bg }};
    --t-scanline: {{ t.scanline }};
    --t-footer-bg: {{ t.footer_bg }};
    --home-color: {{ home.color }};
    --away-color: {{ away.color }};
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { margin: 0; background: var(--t-board-bg); font-family: 'Vazirmatn', sans-serif; }
  bdi, .font-mono-en { font-family: 'JetBrains Mono', 'Vazirmatn', monospace; unicode-bidi: plaintext; }
  .font-display-en { font-family: 'Space Grotesk', 'JetBrains Mono', sans-serif; unicode-bidi: plaintext; }
  .num { font-variant-numeric: tabular-nums; }

  #export-artboard {
    position: relative; overflow: hidden; width: {{ format.w }}px; height: {{ format.h }}px;
    background-color: var(--t-board-bg); color: var(--t-text-main);
    display: flex; flex-direction: column; justify-content: space-between;
  }

  /* لایهٔ ۱: نور محیطی رنگ تیم‌ها — قوی‌تر از استودیو (درخواست کاربر) */
  #card-ambient-glow { position: absolute; inset: 0; pointer-events: none; z-index: 0; background: {{ pitch.ambient }}; }

  /* لایهٔ ۲: خطوط تاکتیکی زمین + قاب پیرامونی */
  #card-pitch-svg { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 0; }

  /* لایهٔ ۳: اسکن‌لاین پخش */
  .broadcast-scanlines {
    position: absolute; inset: 0; pointer-events: none; z-index: 0;
    background: repeating-linear-gradient(to bottom,
      var(--t-scanline) 0px, var(--t-scanline) 1px, transparent 1px, transparent 4px);
  }

  /* ── ۱. سرصفحه ── */
  #card-masthead {
    position: relative; z-index: 10; padding: 26px 36px 8px;
    display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; flex-shrink: 0;
  }
  .masthead-right { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; }
  .masthead-pills { display: flex; align-items: center; gap: 10px; }
  .pill-competition {
    padding: 6px 16px; border-radius: 999px; font-size: 18px; font-weight: 900;
    display: flex; align-items: center; gap: 8px;
    background-color: {{ t.comp_pill_bg }}; color: {{ t.comp_pill_text }};
    border: 1.5px solid var(--t-card-border);
  }
  .pill-round {
    padding: 6px 16px; border-radius: 999px; font-size: 17px; font-weight: 700; letter-spacing: -0.01em;
    background-color: {{ t.accent }}20; border: 1px solid {{ t.accent }}66; color: var(--t-accent);
  }
  .masthead-meta { display: flex; align-items: center; gap: 10px; font-size: 15.5px; font-weight: 700; color: var(--t-text-sub); }
  .masthead-meta .sep { color: var(--t-text-muted); opacity: 0.6; }
  .meta-stadium { display: inline-flex; align-items: center; gap: 6px; color: var(--t-text-main); }
  .pill-broadcast {
    padding: 2px 12px; border-radius: 999px; font-size: 14px; font-weight: 800;
    background: var(--t-accent); border: 1px solid var(--t-accent); color: var(--t-accent-contrast);
  }
  #card-brand-logo { display: flex; align-items: center; gap: 14px; flex-shrink: 0; }
  .brand-logo-lockup { display: flex; align-items: center; }
  .brand-logo-img { height: 42px; width: auto; display: block; }

  /* ── ۲. بدنه ── */
  #card-main-body {
    position: relative; z-index: 10; flex: 1; padding: 8px 36px;
    display: flex; flex-direction: column; justify-content: space-between; gap: 12px; overflow: hidden;
  }
  #card-hero-section { display: flex; flex-direction: column; justify-content: space-between; flex-shrink: 0; }
  .matchup-grid { display: grid; grid-template-columns: repeat(12, 1fr); align-items: center; gap: 8px; }
  .team-col { grid-column: span 4; display: flex; flex-direction: column; align-items: center; text-align: center; }
  .crest-wrap { position: relative; width: 166px; height: 166px; display: flex; align-items: center; justify-content: center; margin-bottom: 4px; }
  .crest-slot { position: relative; z-index: 10; display: flex; align-items: center; justify-content: center; }
  .crest-slot img, .crest-slot svg { width: 164px; height: 164px; object-fit: contain; }
  .team-name { font-size: 36px; font-weight: 900; line-height: 1.1; letter-spacing: -0.02em; color: var(--t-text-main); }
  .team-sub { font-size: 15px; font-weight: 700; opacity: 0.8; margin-top: 4px; max-width: 290px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .scorers-pill {
    margin-top: 8px; padding: 4px 12px; border-radius: 12px; border: 1.5px solid var(--t-card-border);
    font-size: 14px; font-weight: 800; display: inline-flex; align-items: center; gap: 6px;
    max-width: 300px; background: var(--t-surface); color: var(--t-text-sub);
  }
  .scorers-pill span.txt { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .hub-col { grid-column: span 4; display: flex; flex-direction: column; align-items: center; justify-content: space-between; text-align: center; padding: 0 4px; gap: 12px; }
  .giant-score-row { width: 100%; display: flex; align-items: center; justify-content: center; gap: 20px; padding-top: 4px; }
  .score-num { font-size: {{ score_size }}px; font-weight: 900; line-height: 0.84; letter-spacing: -0.05em; color: var(--t-text-main); }
  .score-underbar { width: 88px; height: 12px; border-radius: 999px; margin-top: 10px; }
  .score-divider { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; padding-bottom: 12px; }
  .score-divider .d1 { width: 14px; height: 14px; border-radius: 999px; background: var(--t-accent); }
  .score-divider .d2 { width: 14px; height: 14px; border-radius: 999px; opacity: 0.45; background: var(--t-text-main); }

  .center-xg-box {
    width: 100%; padding: 10px; border-radius: 16px; border: 1.5px solid var(--t-card-border);
    background: var(--t-xgbox-bg); box-shadow: var(--t-card-shadow);
  }
  .xg-main-row { display: flex; align-items: center; justify-content: center; gap: 10px; }
  .xg-val { font-size: 31px; font-weight: 900; line-height: 1; }
  .xg-label { font-size: 15px; font-weight: 900; color: var(--t-text-muted); }
  .xg-sub-row {
    margin-top: 8px; padding-top: 6px; border-top: 1px solid var(--t-card-border);
    display: flex; align-items: center; justify-content: space-around; font-size: 13px;
  }
  .xg-sub-row .cell-label { color: var(--t-text-muted); display: block; font-size: 12px; }
  .xg-sub-row strong { font-weight: 800; color: var(--t-text-main); }
  .xg-sub-row .vsep { height: 16px; width: 1px; background: var(--t-card-border); }

  .capsule-block { margin-top: 16px; }
  .prob-capsule {
    width: 100%; height: 36px; border-radius: 999px; overflow: hidden; display: flex;
    background: var(--t-capsule-bg); border: 1.5px solid var(--t-card-border);
    box-shadow: inset 0 2px 5px rgba(0, 0, 0, 0.14);
  }
  .prob-seg { height: 100%; display: flex; align-items: center; justify-content: center; font-weight: 900; font-size: 16px; border-radius: 0 !important; }
  .telemetry-row {
    position: relative; width: 100%; height: 28px; display: flex; align-items: center;
    justify-content: space-between; padding: 0 4px; font-size: 13.5px; font-weight: 800; color: var(--t-text-sub);
  }
  .telemetry-row .chip { font-size: 13.5px; font-weight: 900; padding: 2px 8px; border-radius: 8px; background: var(--t-surface); }

  /* ── ۳. گرید ماژول‌ها ── */
  #modules-grid { flex: 1; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; align-content: stretch; min-height: 0; }
  .xg-glass-card {
    position: relative; background: var(--t-card-bg); border: 1.5px solid var(--t-card-border);
    border-radius: 20px; padding: 13px 17px; box-shadow: var(--t-card-shadow);
    display: flex; flex-direction: column; justify-content: space-between; overflow: hidden;
  }
  .xg-tactical-editorial {
    position: relative; background: var(--t-editorial-bg); border: 1.5px solid var(--t-editorial-border);
    border-radius: 20px; padding: 13px 17px; box-shadow: var(--t-card-shadow);
    display: flex; flex-direction: column; justify-content: space-between; overflow: hidden;
  }
  .span-half { grid-column: span 1; }
  .span-full { grid-column: span 2; }
  .mod-head {
    display: flex; align-items: center; justify-content: space-between; gap: 8px;
    padding-bottom: 6px; margin-bottom: 6px; border-bottom: 1px solid {{ t.grid_stroke }}1A;
  }
  .mod-head-l { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .mod-chip { width: 6px; height: 20px; border-radius: 999px; background: var(--t-accent); flex-shrink: 0; }
  .mod-title { font-size: 16px; font-weight: 900; color: var(--t-text-main); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .mod-tag { font-size: 12.5px; font-family: 'JetBrains Mono', monospace; color: var(--t-text-muted); flex-shrink: 0; }

  .comp-rows { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 9px; }
  .comp-row .vals { display: grid; grid-template-columns: 1fr 1.2fr 1fr; align-items: center; margin-bottom: 4px; }
  .comp-row .v-h { text-align: right; font-size: 19px; font-weight: 900; line-height: 1; }
  .comp-row .v-a { text-align: left; font-size: 19px; font-weight: 900; line-height: 1; }
  .comp-row .v-h small, .comp-row .v-a small { font-size: 13px; font-weight: 700; opacity: 0.8; }
  .comp-row .lbl { text-align: center; font-size: 14px; font-weight: 700; color: var(--t-text-sub); }
  .comp-row .bars { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; }
  .comp-bar-track { height: 10px; background: var(--t-track-bg); overflow: hidden; display: flex; align-items: center; }
  .comp-bar-track.home-side { border-radius: 0 999px 999px 0; justify-content: flex-end; }
  .comp-bar-track.away-side { border-radius: 999px 0 0 999px; justify-content: flex-start; }
  .comp-bar-fill-home { height: 100%; border-radius: 0 999px 999px 0; }
  .comp-bar-fill-away { height: 100%; border-radius: 999px 0 0 999px; }

  .story-body { position: relative; z-index: 10; }
  .story-title { font-size: 17px; font-weight: 900; margin-bottom: 6px; color: var(--t-accent); }
  .story-line { font-size: 14.5px; line-height: 1.65; font-weight: 500; color: var(--t-text-sub); }
  .editorial-pitch {
    position: absolute; left: 12px; bottom: 12px; width: 128px; height: auto; opacity: 0.12; pointer-events: none;
  }

  .trend-svg { width: 100%; height: 166px; display: block; }
  .trend-foot { display: flex; align-items: center; justify-content: space-between; font-size: 13px; font-weight: 700; color: var(--t-text-sub); padding-top: 4px; }

  .sq-rows { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 8px; }
  .sq-row {
    display: flex; align-items: center; justify-content: space-between; padding: 8px 12px;
    border-radius: 12px; border: 1px solid var(--t-card-border); background: var(--t-surface);
  }
  .sq-row .v-h, .sq-row .v-a { font-size: 17px; font-weight: 900; }
  .sq-row .lbl { font-size: 13.5px; font-weight: 700; color: var(--t-text-sub); }

  .verdict-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; flex: 1; align-items: stretch; }
  .verdict-card {
    border-radius: 16px; padding: 10px 12px; border: 1px solid; background: var(--t-surface);
    display: flex; align-items: center; justify-content: space-between; gap: 8px;
  }
  .verdict-card.vc-green { border-color: {{ t.verdict_green }}59; border-right: 4px solid {{ t.verdict_green }}; }
  .verdict-card.vc-sky { border-color: {{ t.verdict_sky }}59; border-right: 4px solid {{ t.verdict_sky }}; }
  .verdict-card.vc-amber { border-color: {{ t.verdict_amber }}59; border-right: 4px solid {{ t.verdict_amber }}; }
  .verdict-badge {
    display: inline-block; font-family: 'JetBrains Mono', monospace; font-size: 12px; font-weight: 800;
    padding: 2px 8px; border-radius: 6px; margin-bottom: 4px;
  }
  .verdict-title { font-size: 15px; font-weight: 900; color: var(--t-text-main); line-height: 1.3; }
  .verdict-desc { font-size: 12.5px; margin-top: 2px; color: var(--t-text-sub); line-height: 1.45; }
  .verdict-value { font-size: 21px; font-weight: 900; line-height: 1; }

  /* ── ۴. پانویس ── */
  #card-footer {
    position: relative; z-index: 10; padding: 10px 36px; border-top: 1px solid var(--t-card-border);
    background: var(--t-footer-bg); display: flex; align-items: center; justify-content: space-between;
    font-size: 13px; flex-shrink: 0; color: var(--t-text-sub);
  }
  .footer-dot { width: 8px; height: 8px; border-radius: 999px; background: var(--t-accent); display: inline-block; margin-left: 8px; }
  .footer-tag { font-family: 'JetBrains Mono', monospace; font-size: 13.5px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--t-text-main); }
  .footer-left { display: flex; align-items: center; gap: 12px; font-family: 'JetBrains Mono', monospace; font-weight: 700; }
  .footer-left .sep { opacity: 0.4; }
  .footer-source { opacity: 0.8; font-weight: 500; font-size: 12.5px; }

  /* ── فرمت‌ها ── */
  .fmt-169 #card-main-body { display: grid; grid-template-columns: repeat(12, 1fr); gap: 28px; align-items: stretch; padding: 8px 36px; }
  .fmt-169 #card-hero-section { grid-column: span 5; border-left: 1px solid {{ t.grid_stroke }}26; padding-left: 28px; }
  .fmt-169 #modules-grid { grid-column: span 7; gap: 14px; }
  .fmt-169 .comp-row .v-h, .fmt-169 .comp-row .v-a { font-size: 21px; }
  .fmt-169 .comp-row .lbl { font-size: 15.5px; }
  .fmt-169 .story-line { font-size: 16px; }
  .fmt-169 .story-title { font-size: 18px; }
  .fmt-169 .sq-row .lbl { font-size: 15px; }
  .fmt-169 .sq-row .v-h, .fmt-169 .sq-row .v-a { font-size: 18px; }
  .fmt-169 .verdict-title { font-size: 16px; }
  .fmt-169 .verdict-desc { font-size: 13.5px; }
  .fmt-169 .mod-title { font-size: 17px; }
  .fmt-916 #card-main-body { padding: 20px 36px; gap: 20px; }
  .fmt-916 #modules-grid { gap: 16px; }
</style>
</head>
<body>
<div id="export-artboard" dir="rtl" class="fmt-{{ '169' if format.is_wide else ('916' if format.is_tall else '45') }}">

  <div id="card-ambient-glow"></div>

  <svg id="card-pitch-svg" viewBox="0 0 {{ format.w }} {{ format.h }}" preserveAspectRatio="xMidYMid slice" fill="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <pattern id="techGridPattern" width="54" height="54" patternUnits="userSpaceOnUse">
        <path d="M 54 0 L 0 0 0 54" fill="none" stroke="{{ t.grid_stroke }}" stroke-opacity="{{ t.grid_opacity }}" stroke-width="1" />
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#techGridPattern)" />
    <rect x="12" y="12" width="{{ format.w - 24 }}" height="{{ format.h - 24 }}" rx="18" stroke="{{ t.accent }}" stroke-opacity="{{ t.perimeter_opacity }}" stroke-width="1.5" />
    <line x1="{{ format.w // 2 }}" y1="12" x2="{{ format.w // 2 }}" y2="{{ format.h - 12 }}" stroke="{{ t.pitch_stroke }}" stroke-opacity="{{ t.pitch_opacity }}" stroke-width="1.5" stroke-dasharray="8 8" />
    <circle cx="{{ format.w // 2 }}" cy="295" r="165" stroke="{{ t.pitch_stroke }}" stroke-opacity="{{ t.pitch_opacity }}" stroke-width="1.5" />
    <rect x="12" y="125" width="145" height="340" stroke="{{ t.pitch_stroke }}" stroke-opacity="{{ t.pitch_opacity }}" stroke-width="1.5" />
    <rect x="{{ format.w - 157 }}" y="125" width="145" height="340" stroke="{{ t.pitch_stroke }}" stroke-opacity="{{ t.pitch_opacity }}" stroke-width="1.5" />
    <path d="{{ pitch.crosshairs }}" stroke="{{ t.accent }}" stroke-opacity="0.6" stroke-width="2.2" />
  </svg>

  <div class="broadcast-scanlines"></div>

  <!-- ۱. سرصفحه -->
  <header id="card-masthead">
    <div class="masthead-right">
      <div class="masthead-pills">
        <div class="pill-competition">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="{{ t.accent }}" stroke-width="2.4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 21h8m-4-4v4m-5-17h10v5a5 5 0 01-10 0V4zM5 6H3v2a3 3 0 003 3h1m12-5h2v2a3 3 0 01-3 3h-1" />
          </svg>
          <span>{{ competition_fa }}</span>
        </div>
        <span class="pill-round">{{ round_fa }}</span>
      </div>
      <div class="masthead-meta">
        {% if day %}<span>{{ day }}</span>{% endif %}
        {% if stadium %}
        <span class="sep">|</span>
        <span class="meta-stadium">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="{{ t.accent }}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <ellipse cx="12" cy="8" rx="9" ry="3.5" />
            <path d="M3 8v6c0 1.93 4.03 3.5 9 3.5s9-1.57 9-3.5V8" />
            <path d="M7 11.2v5.8M12 11.5v6M17 11.2v5.8" />
            <path d="M6 4.8V3M18 4.8V3" />
          </svg>
          <span>{{ stadium }}</span>
        </span>
        {% endif %}
        <span class="sep">|</span>
        <span class="pill-broadcast">{{ broadcast }}</span>
      </div>
    </div>
    {% if brand_lockup_html %}<div id="card-brand-logo">{{ brand_lockup_html | safe }}</div>{% endif %}
  </header>

  <!-- ۲. بدنه -->
  <div id="card-main-body">
    <section id="card-hero-section">
      <div class="matchup-grid">

        <!-- میزبان (راست) -->
        <div class="team-col">
          <div class="crest-wrap"><div class="crest-slot">{{ home.crest_html | safe }}</div></div>
          <h1 class="team-name">{{ home.name_fa }}</h1>
          <p class="team-sub"><bdi>{{ home.name_en }} • {{ home.code }}</bdi></p>
          {% if home.scorers %}
          <div class="scorers-pill"><span>⚽</span><span class="txt">{{ home.scorers }}</span></div>
          {% endif %}
        </div>

        <!-- مرکز: نتیجهٔ درشت + جعبهٔ xG/xPts -->
        <div class="hub-col">
          {% if score.home is not none and score.away is not none %}
          <div class="giant-score-row">
            <div style="display:flex; flex-direction:column; align-items:center;">
              <span class="score-num num">{{ score.home }}</span>
              <span class="score-underbar" style="background: var(--home-color);"></span>
            </div>
            <div class="score-divider"><span class="d1"></span><span class="d2"></span></div>
            <div style="display:flex; flex-direction:column; align-items:center;">
              <span class="score-num num">{{ score.away }}</span>
              <span class="score-underbar" style="background: var(--away-color);"></span>
            </div>
          </div>
          {% endif %}

          {% if hero.xg_home and hero.xg_away %}
          <div class="center-xg-box">
            <div class="xg-main-row">
              <span class="xg-val num" style="color: {{ home.ink }};">{{ hero.xg_home }}</span>
              <span class="xg-label font-mono-en">xG</span>
              <span class="xg-val num" style="color: {{ away.ink }};">{{ hero.xg_away }}</span>
            </div>
            <div class="xg-sub-row">
              <div>
                <span class="cell-label">امتیاز انتظاری</span>
                <strong class="num">{{ hero.xpts_home or na_label }} <span class="font-mono-en" style="font-size:12px;">xPts</span></strong>
              </div>
              <div class="vsep"></div>
              <div>
                <span class="cell-label">مجموع xG بازی</span>
                <strong class="num" style="color: var(--t-accent);">{{ hero.xg_total or na_label }}</strong>
              </div>
              <div class="vsep"></div>
              <div>
                <span class="cell-label">امتیاز انتظاری</span>
                <strong class="num">{{ hero.xpts_away or na_label }} <span class="font-mono-en" style="font-size:12px;">xPts</span></strong>
              </div>
            </div>
          </div>
          {% endif %}
        </div>

        <!-- میهمان (چپ) -->
        <div class="team-col">
          <div class="crest-wrap"><div class="crest-slot">{{ away.crest_html | safe }}</div></div>
          <h2 class="team-name">{{ away.name_fa }}</h2>
          <p class="team-sub"><bdi>{{ away.name_en }} • {{ away.code }}</bdi></p>
          {% if away.scorers %}
          <div class="scorers-pill"><span>⚽</span><span class="txt">{{ away.scorers }}</span></div>
          {% endif %}
        </div>
      </div>

      {% if capsule %}
      <div class="capsule-block">
        <div class="prob-capsule">
          {% for seg in capsule %}
          <div class="prob-seg num" style="width: {{ seg.pct }}%; background: {{ seg.bg }}; color: {{ seg.color }};">{% if seg.pct >= 11 %}{{ seg.pct }}٪{% endif %}</div>
          {% endfor %}
        </div>
        <div class="telemetry-row">
          <div style="display:flex; align-items:center; gap:6px; z-index:10;">
            <span style="opacity:0.75;">بهره‌وری گل میزبان:</span>
            {% if hero.delta_home %}<span dir="ltr" class="chip num" style="color: {{ home.ink }};">{{ hero.delta_home }}</span>{% endif %}
          </div>
          <div style="display:flex; align-items:center; gap:6px; z-index:10; opacity:0.85;">
            <span>شبیه‌سازی عدالت نتیجه بر اساس xG</span>
          </div>
          <div style="display:flex; align-items:center; gap:6px; z-index:10;">
            <span style="opacity:0.75;">بهره‌وری گل میهمان:</span>
            {% if hero.delta_away %}<span dir="ltr" class="chip num" style="color: {{ away.ink }};">{{ hero.delta_away }}</span>{% endif %}
          </div>
        </div>
      </div>
      {% endif %}
    </section>

    <!-- ۳. گرید ماژول‌ها -->
    <section id="modules-grid">
      {% for m in modules %}{% if m.enabled %}

      {% if m.id == 'stats' and module_data.stats.rows %}
      <div class="xg-glass-card {{ 'span-half' if m.span == 'half' else 'span-full' }}">
        <div class="mod-head">
          <div class="mod-head-l"><span class="mod-chip"></span><h3 class="mod-title">آمار کلیدی مسابقه (۹۰ دقیقه)</h3></div>
          <span class="mod-tag">MATCH TELEMETRY</span>
        </div>
        <div class="comp-rows">
          {% for r in module_data.stats.rows %}
          <div class="comp-row">
            <div class="vals">
              <span class="v-h num" style="color: {{ r.h_ink }};">{{ r.h }} {% if r.sub_h %}<small class="num">{{ r.sub_h }}</small>{% endif %}</span>
              <span class="lbl">{{ r.label }}</span>
              <span class="v-a num" style="color: {{ r.a_ink }};">{% if r.sub_a %}<small class="num">{{ r.sub_a }}</small>{% endif %} {{ r.a }}</span>
            </div>
            <div class="bars">
              <div class="comp-bar-track home-side"><div class="comp-bar-fill-home" style="width: {{ r.h_pct }}%; background: var(--home-color);"></div></div>
              <div class="comp-bar-track away-side"><div class="comp-bar-fill-away" style="width: {{ r.a_pct }}%; background: var(--away-color);"></div></div>
            </div>
          </div>
          {% endfor %}
        </div>
      </div>
      {% endif %}

      {% if m.id == 'story' and module_data.story %}
      <div class="xg-tactical-editorial {{ 'span-half' if m.span == 'half' else 'span-full' }}">
        <svg class="editorial-pitch" viewBox="0 0 240 160" fill="none" stroke="{{ t.text_main }}" stroke-width="2.5">
          <rect x="2" y="2" width="236" height="156" rx="6" />
          <line x1="120" y1="2" x2="120" y2="158" />
          <circle cx="120" cy="80" r="32" />
          <rect x="2" y="42" width="36" height="76" />
          <rect x="202" y="42" width="36" height="76" />
        </svg>
        <div class="story-body">
          <div class="mod-head">
            <div class="mod-head-l"><span class="mod-chip"></span><h3 class="mod-title">روایت آماری و گره بازی</h3></div>
            <span class="mod-tag">MATCH STORY</span>
          </div>
          <h4 class="story-title">{{ module_data.story.title }}</h4>
          {% for line in module_data.story.body_lines %}
          <p class="story-line">{{ line }}</p>
          {% endfor %}
        </div>
        {% if module_data.story.tag %}
        <div class="trend-foot" style="margin-top:8px; padding-top:8px; border-top:1px solid {{ t.grid_stroke }}1A;">
          <span style="width:8px; height:8px; border-radius:999px; background: var(--t-accent); display:inline-block;"></span>
          <span>{{ module_data.story.tag }}</span>
        </div>
        {% endif %}
      </div>
      {% endif %}

      {% if m.id == 'trend10' and module_data.trend10 %}
      {% set tr = module_data.trend10 %}
      <div class="xg-glass-card {{ 'span-half' if m.span == 'half' else 'span-full' }}">
        <div class="mod-head">
          <div class="mod-head-l"><span class="mod-chip"></span><h3 class="mod-title">روند xG ده بازی اخیر (شامل این بازی)</h3></div>
          <span class="mod-tag">XG TREND</span>
        </div>
        <div style="flex:1; display:flex; align-items:center;" dir="ltr">
          <svg class="trend-svg" viewBox="0 0 {{ tr.w }} {{ tr.h }}" fill="none">
            <g stroke="{{ t.grid_stroke }}" stroke-opacity="0.18" stroke-width="1" stroke-dasharray="3 3">
              <line x1="22" y1="14" x2="{{ tr.w - 22 }}" y2="14" />
              <line x1="22" y1="{{ 14 + (tr.h - 28) / 2 }}" x2="{{ tr.w - 22 }}" y2="{{ 14 + (tr.h - 28) / 2 }}" />
              <line x1="22" y1="{{ tr.h - 14 }}" x2="{{ tr.w - 22 }}" y2="{{ tr.h - 14 }}" />
            </g>
            <path d="{{ tr.away_path }} L {{ tr.w - 22 }} {{ tr.h - 14 }} L 22 {{ tr.h - 14 }} Z" fill="{{ away.color }}" fill-opacity="0.08" />
            <path d="{{ tr.away_path }}" stroke="{{ away.color }}" stroke-width="2.6" fill="none" stroke-linejoin="round" />
            <path d="{{ tr.home_path }}" stroke="{{ home.color }}" stroke-width="3.1" fill="none" stroke-linejoin="round" />
            {% for d in tr.home_dots %}
            <circle cx="{{ d.x }}" cy="{{ d.y }}" r="4" fill="{{ home.color }}" stroke="{{ t.card_bg }}" stroke-width="1.6" />
            {% endfor %}
          </svg>
        </div>
        <div class="trend-foot">
          <span style="display:flex; align-items:center; gap:6px;"><span style="width:10px; height:4px; border-radius:2px; background: var(--home-color); display:inline-block;"></span>{{ home.name_fa }}: میانگین <span class="num">{{ tr.home_avg }}</span></span>
          <span style="display:flex; align-items:center; gap:6px;"><span style="width:10px; height:4px; border-radius:2px; background: var(--away-color); display:inline-block;"></span>{{ away.name_fa }}: میانگین <span class="num">{{ tr.away_avg }}</span></span>
        </div>
      </div>
      {% endif %}

      {% if m.id == 'shotquality' and module_data.shotquality.rows %}
      <div class="xg-glass-card {{ 'span-half' if m.span == 'half' else 'span-full' }}">
        <div class="mod-head">
          <div class="mod-head-l"><span class="mod-chip"></span><h3 class="mod-title">توزیع کیفیت شوت‌ها</h3></div>
          <span class="mod-tag">SHOT QUALITY</span>
        </div>
        <div class="sq-rows">
          {% for it in module_data.shotquality.rows %}
          <div class="sq-row">
            <span class="v-h num" style="color: {{ it.h_ink }};">{{ it.h }}</span>
            <span class="lbl">{{ it.label }}</span>
            <span class="v-a num" style="color: {{ it.a_ink }};">{{ it.a }}</span>
          </div>
          {% endfor %}
        </div>
      </div>
      {% endif %}

      {% if m.id == 'verdict' and module_data.verdict %}
      {% set v = module_data.verdict %}
      <div class="xg-glass-card {{ 'span-half' if m.span == 'half' else 'span-full' }}">
        <div class="mod-head">
          <div class="mod-head-l"><span class="mod-chip"></span><h3 class="mod-title">شاخص عدالت آماری و ارزیابی مدل</h3></div>
          <span class="mod-tag" style="color: var(--t-accent);">POST-MATCH VERDICT</span>
        </div>
        <div class="verdict-grid">
          <div class="verdict-card vc-green">
            <div>
              <span dir="ltr" class="verdict-badge font-mono-en" style="background: {{ t.verdict_green }}33; color: {{ t.verdict_green }};">xG FAIRNESS</span>
              <div class="verdict-title">{{ v.fair_title }}</div>
              <div class="verdict-desc">{{ v.fair_desc }}</div>
            </div>
            <div dir="ltr" class="verdict-value num" style="color: {{ t.verdict_green }};">{{ v.fair_value }}</div>
          </div>
          <div class="verdict-card vc-sky">
            <div>
              <span dir="ltr" class="verdict-badge font-mono-en" style="background: {{ t.verdict_sky }}33; color: {{ t.verdict_sky }};">FINISHING</span>
              <div class="verdict-title">دقت ضربه نهایی</div>
              <div class="verdict-desc">برتر: {{ v.fin_best }}</div>
            </div>
            <div dir="ltr" class="verdict-value num" style="color: {{ t.verdict_sky }};">{{ v.fin_value }}</div>
          </div>
          <div class="verdict-card vc-amber">
            <div>
              <span dir="ltr" class="verdict-badge font-mono-en" style="background: {{ t.verdict_amber }}33; color: {{ t.verdict_amber }};">TEMPO &amp; RISK</span>
              <div class="verdict-title">{{ v.tempo }}</div>
              <div class="verdict-desc">{{ v.tempo_label }}</div>
            </div>
            <div class="verdict-value num" style="color: {{ t.verdict_amber }}; font-size: 24px;">{{ v.tempo_value or na_label }}</div>
          </div>
        </div>
      </div>
      {% endif %}

      {% endif %}{% endfor %}
    </section>
  </div>

  <!-- ۴. پانویس -->
  <footer id="card-footer">
    <div style="display:flex; align-items:center; gap:8px;">
      <span class="footer-dot"></span>
      <span dir="ltr" class="footer-tag font-mono-en">{{ micro_tag }}</span>
    </div>
    <div class="footer-left" dir="ltr">
      <span>{{ handle }}</span>
      <span class="sep">•</span>
      <span>{{ domain }}</span>
      <span class="sep">|</span>
      <span class="footer-source">{{ source_label }}</span>
    </div>
  </footer>
</div>
</body>
</html>
